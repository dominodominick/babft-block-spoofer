--[[ BABFT Block Spoofer v2 — self-contained UI ]]
if _G.BABFT_UI then pcall(function() _G.BABFT_UI:Destroy() end) end

local Players     = game:GetService("Players")
local UIS         = game:GetService("UserInputService")
local RS          = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Mouse       = LocalPlayer:GetMouse()

local C = {
    bg = Color3.fromRGB(22, 24, 30), panel = Color3.fromRGB(31, 34, 42),
    accent = Color3.fromRGB(108, 140, 255), ok = Color3.fromRGB(96, 200, 120),
    warn = Color3.fromRGB(230, 190, 90), err = Color3.fromRGB(235, 100, 100),
    text = Color3.fromRGB(228, 231, 238), dim = Color3.fromRGB(140, 146, 160),
}

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

-- parent resolution, PlayerGui first
local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
if not playerGui then playerGui = LocalPlayer:WaitForChild("PlayerGui", 10) end

local gui
local built, buildErr = pcall(function()
    gui = new("ScreenGui", {
        Name = "BABFTUI", ResetOnSpawn = false, IgnoreGuiInset = true,
        DisplayOrder = 999, Enabled = true,
    }, playerGui)
end)

if not built or not gui then
    -- last-resort visible error
    local f = new("TextLabel", {
        Size = UDim2.fromOffset(360, 60), Position = UDim2.fromOffset(20, 20),
        BackgroundColor3 = Color3.fromRGB(120, 30, 30), TextColor3 = Color3.new(1,1,1),
        Font = Enum.Font.Code, TextSize = 12, TextWrapped = true,
        Text = "UI FAILED: " .. tostring(buildErr),
    }, playerGui)
    warn("[spoofer] UI build failed:", buildErr)
    return
end
_G.BABFT_UI = gui

--------------------------------------------------------------- state
local grid, spacing, atCursor = { 3, 3 }, 4, false

local function equip()
    local char     = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local t = (char and char:FindFirstChild("BuildingTool"))
           or (backpack and backpack:FindFirstChild("BuildingTool"))
    if t and t.Parent == backpack and char and char:FindFirstChild("Humanoid") then
        char.Humanoid:EquipTool(t)
        task.wait(0.2)
    end
    return t
end

local function findZone()
    for _, v in ipairs(workspace:GetChildren()) do
        local tc = v:FindFirstChild("TeamColor")
        if tc then
            local val = tc:IsA("ValueBase") and tc.Value or tc
            if val == LocalPlayer.TeamColor then return v end
        end
    end
end

local function count(z)
    local n = 0
    for _ in z:GetDescendants() do n += 1 end
    return n
end

--------------------------------------------------------------- shell
