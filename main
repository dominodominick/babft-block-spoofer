    local z = findZone()
    if not z then return log("no zone", "err") end
    local before = count(z)
    placeRemote()
    task.wait(0.3)
    log(count(z) > before and "SPAWNED" or "nothing spawned", count(z) > before and "ok" or "err")
end)
