task.spawn(function()
    while gui.Parent do
        local char = LocalPlayer.Character
        local t = (char and char:FindFirstChild("BuildingTool"))
               or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer:FindFirstChild("Backpack"):FindFirstChild("BuildingTool"))
        local z = findZone()
        status.Text = ("tool:%s zone:%s blocks:%d"):format(t and "YES" or "no", z and "YES" or "no", z and count(z) or 0)
        status.TextColor3 = (t and z) and C.ok or C.warn
        task.wait(1)
    end
end)

local function label(text, y)
    new("TextLabel", {
        Size = UDim2.new(1,-20,0,13), Position = UDim2.fromOffset(10,y), BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = C.dim,
        TextXAlignment = Enum.TextXAlignment.Left, Text = text,
    }, frame)
end

local function button(text, w, x, y, col, cb)
    local b = new("TextButton", {
        Size = UDim2.fromOffset(w,26), Position = UDim2.fromOffset(x,y),
        BackgroundColor3 = col or C.panel, BorderSizePixel = 0, Font = Enum.Font.GothamBold,
        TextSize = 11, TextColor3 = C.text, Text = text,
    }, frame)
    new("UICorner", { CornerRadius = UDim.new(0,6) }, b)
    b.MouseButton1Click:Connect(function()
        local ok, err = pcall(cb)
        if not ok then log("error: " .. tostring(err), "err") end
    end)
    return b
end

