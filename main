            frame.Position = UDim2.fromOffset(sf.X.Offset + d.X, sf.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then on = false end
    end)
end

local status = new("TextLabel", {
    Size = UDim2.new(1,-20,0,20), Position = UDim2.fromOffset(10,36),
    BackgroundColor3 = Color3.fromRGB(14,16,20), BorderSizePixel = 0, Font = Enum.Font.Code,
