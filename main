new("UICorner", { CornerRadius = UDim.new(0, 10) }, header)
new("TextLabel", {
    Size = UDim2.new(1,-40,1,0), Position = UDim2.fromOffset(12,0), BackgroundTransparency = 1,
    Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.text,
    TextXAlignment = Enum.TextXAlignment.Left, Text = "BLOCK SPOOFER v3",
