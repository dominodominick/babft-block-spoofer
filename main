local function resolveRF()
    local t = equip()
    if not t then return nil, "no BuildingTool" end
    local rf = t:FindFirstChildOfClass("RemoteFunction")
    if not rf then return nil, "tool has no RemoteFunction" end
    return rf
end

local function originPoint()
    if atCursor and Mouse.Hit then return Mouse.Hit.Position end
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then return (root.CFrame * CFrame.new(0,0,-18)).Position end
end

local function placeRemote()
    local name = nameBox.Text
    if name == "" then return 0, "no name set" end
    local rf, e = resolveRF()
    if not rf then return 0, e end
    local z = findZone()
    if not z then return 0, "zone not found" end
    local origin = originPoint()
    if not origin then return 0, "no position" end
    local id = tonumber(idBox.Text) or 9
    local nx, ny = grid[1], grid[2]
    local done, fail, lastErr = 0, 0, nil
    log(("remote: %dx%d %s"):format(nx, ny, name))
    for x = -(nx-1)/2, (nx-1)/2 do
        for y = 0, ny-1 do
            local p = origin + Vector3.new(x*spacing, y*spacing, 0)
            local ok, err = pcall(rf.InvokeServer, rf, name, id, z,
                z.CFrame:ToObjectSpace(CFrame.new(p)), true, p, false)
            if ok then done += 1 else fail += 1; lastErr = err end
            task.wait(0.03)
        end
    end
    if lastErr then log("last error: " .. tostring(lastErr), "err") end
    return done, fail
end

local function placeActivate()
    local t = equip()
    if not t then return 0, "no BuildingTool" end
    local holder
    for _, ch in ipairs(t:GetChildren()) do
        if ch:IsA("ValueBase") then
            local n = ch.Name:lower()
            if n:find("block") or n:find("select") or n:find("current") then holder = ch; break end
        end
    end
    if holder then
        local ok = pcall(function() holder.Value = nameBox.Text end)
        log(ok and ("set " .. holder.Name) or "could not set holder", ok and "ok" or "warn")
    else
        log("no block holder on tool", "warn")
    end
    for _ = 1, math.min(grid[1] * grid[2], 8) do
        pcall(function() t:Activate() end)
        task.wait(0.12)
    end
    return 1, 0
end

local function place()
    local name = nameBox.Text
    if name == "" then return log("set a block name", "err") end
    local z = findZone()
    if not z then return log("PLOT ZONE NOT FOUND — see diagnose", "err") end
    local done, fail = placeRemote()
    if type(done) ~= "number" then log(tostring(fail), "err"); return end
    log(("%s: %d ok, %d failed"):format(name, done, fail), fail > 0 and "warn" or "ok")
    if done == 0 then
        log("remote rejected — trying Activate fallback", "warn")
        local a = placeActivate()
        log(a > 0 and "activate attempted" or "activate failed", "warn")
    end
end

local function diagnose()
    log("--- DIAGNOSE ---", "warn")
    local char = LocalPlayer.Character
    log("character: " .. (char and "yes" or "NO"), char and "ok" or "err")
    local t = equip()
    log("tool: " .. (t and t:GetFullName() or "NOT FOUND"), t and "ok" or "err")
    if t then
        for _, ch in ipairs(t:GetChildren()) do log("  child " .. ch.ClassName .. " / " .. ch.Name) end
        for k, v in pairs(t:GetAttributes()) do log(("  attr %s = %s"):format(k, tostring(v))) end
    end
    local z = findZone()
    log("zone: " .. (z and z:GetFullName() or "NOT FOUND"), z and "ok" or "err")
    log("teamcolor: " .. tostring(LocalPlayer.TeamColor))
    local dn = 0
    for _, v in ipairs(LocalPlayer:GetChildren()) do if v.Name == "Data" then dn = #v:GetChildren() end end
    log("data entries: " .. dn)
    local rfs = {}
    for _, v in ipairs(RS:GetDescendants()) do
        if v:IsA("RemoteFunction") then table.insert(rfs, v:GetFullName()) end
    end
    log("RS RemoteFunctions: " .. #rfs)
    for i = 1, math.min(#rfs, 8) do log("  " .. rfs[i]) end
    log("--- END ---", "warn")
end

