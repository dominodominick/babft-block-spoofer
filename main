function addResult(name, ok)
    local row = new("TextButton", {
        Size = UDim2.new(1, -8, 0, 18), BackgroundColor3 = Color3.fromRGB(24, 27, 34),
        BorderSizePixel = 0, Font = Enum.Font.Code, TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = #resultList:GetChildren(),
        TextColor3 = (ok == true and C.ok) or (ok == false and C.err) or C.dim,
        Text = (ok == true and "OK  " or ok == false and "XX  " or "--  ") .. name,
    }, resultList)
    row.MouseButton1Click:Connect(function() nameBox.Text = name end)
    resultList.CanvasSize = UDim2.fromOffset(0, resultList.UIListLayout.AbsoluteContentSize.Y + 8)
end

