local seq = 0
local function log(msg, kind)
    local col = (kind == "ok" and C.ok) or (kind == "err" and C.err) or (kind == "warn" and C.warn) or C.dim
    seq += 1
    new("TextLabel", {
        Size = UDim2.new(1,-10,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Font = Enum.Font.Code, TextSize = 10, TextColor3 = col, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = seq, Text = msg,
    }, logList)
    task.delay(0.05, function()
        if logList.Parent then logList.CanvasSize = UDim2.fromOffset(0, logList.UIListLayout.AbsoluteContentSize.Y + 6) end
    end)
end

