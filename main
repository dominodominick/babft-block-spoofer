    Size = UDim2.fromOffset(112, 32), Position = UDim2.fromOffset(16, 16),
    BackgroundColor3 = C.accent, BorderSizePixel = 0, AutoButtonColor = true,
    Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = C.text, Text = "BLOCKS",
}, gui)
new("UICorner", { CornerRadius = UDim.new(0, 8) }, toggle)

local frame = new("Frame", {
    Size = UDim2.fromOffset(330, 520), Position = UDim2.fromOffset(16, 56),
    BackgroundColor3 = C.bg, BorderSizePixel = 0, Visible = true,
}, gui)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, frame)

local header = new("Frame", {
    Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.panel, BorderSizePixel = 0,
}, frame)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, header)
new("TextLabel", {
    Size = UDim2.new(1, -40, 1, 0), Position = UDim2.fromOffset(12, 0),
    BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13,
    TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, Text = "BLOCK SPOOFER",
}, header)
new("TextButton", {
    Size = UDim2.fromOffset(32, 32), Position = UDim2.new(1, -32, 0, 0),
    BackgroundTransparency = 1, Text = "X", Font = Enum.Font.GothamBold,
    TextSize = 14, TextColor3 = C.dim,
}, header).MouseButton1Click:Connect(function()
    frame.Visible = false; toggle.Text = "BLOCKS"
end)

do -- drag
    local on, sp, sf
    header.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            on, sp, sf = true, i.Position, frame.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if on and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - sp
            frame.Position = UDim2.fromOffset(sf.X.Offset + d.X, sf.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then on = false end
    end)
end

--------------------------------------------------------------- status strip
local status = new("TextLabel", {
    Size = UDim2.new(1, -20, 0, 20), Position = UDim2.fromOffset(10, 36),
    BackgroundColor3 = Color3.fromRGB(14, 16, 20), BorderSizePixel = 0,
    Font = Enum.Font.Code, TextSize = 10, TextColor3 = C.dim,
    TextXAlignment = Enum.TextXAlignment.Left, Text = "checking...",
}, frame)
new("UIPadding", { PaddingLeft = UDim.new(0, 6) }, status)

task.spawn(function()
    while gui.Parent do
        local t = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("BuildingTool"))
               or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer:FindFirstChild("Backpack"):FindFirstChild("BuildingTool"))
        local z = findZone()
        status.Text = ("tool:%s  zone:%s  blocks:%d"):format(t and "YES" or "no", z and "YES" or "no", z and count(z) or 0)
        status.TextColor3 = (t and z) and C.ok or C.warn
        task.wait(1)
    end
end)

--------------------------------------------------------------- log
local function log(msg, kind)
    local col = (kind == "ok" and C.ok) or (kind == "err" and C.err) or (kind == "warn" and C.warn) or C.dim
    print("[spoofer]", msg)
    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 10,
        TextColor3 = col, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
        LayoutOrder = tick() * 1000, Text = ("[%s] %s"):format(os.date("%H:%M:%S"), msg),
    }, logList)
    task.delay(0.05, function()
        if logList and logList.Parent then logList.CanvasSize = UDim2.fromOffset(0, logList.UIListLayout.AbsoluteContentSize.Y + 8) end
    end)
end

--------------------------------------------------------------- widgets
local function label(text, y)
    new("TextLabel", {
        Size = UDim2.new(1, -20, 0, 13), Position = UDim2.fromOffset(10, y),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 10,
        TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left, Text = text,
    }, frame)
end

local function button(text, w, x, y, col, cb)
    local b = new("TextButton", {
        Size = UDim2.fromOffset(w, 26), Position = UDim2.fromOffset(x, y),
        BackgroundColor3 = col or C.panel, BorderSizePixel = 0,
        Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = C.text, Text = text,
    }, frame)
    new("UICorner", { CornerRadius = UDim.new(0, 6) }, b)
    b.MouseButton1Click:Connect(function()
        local ok, err = pcall(cb)
        if not ok then log("error: " .. tostring(err), "err") end
    end)
    return b
end

