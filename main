--------------------------------------------------------------- actions
local function resolveRF()
    local t = equip()
    if not t then return nil, "BuildingTool not found" end
    local rf = t:FindFirstChildOfClass("RemoteFunction")
    if not rf then return nil, "tool has no RemoteFunction" end
    return rf
end

local function originPoint()
    if atCursor and Mouse.Hit then return Mouse.Hit.Position end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then return (root.CFrame * CFrame.new(0, 0, -18)).Position end
    return nil
end

local function place()
    local name = nameBox.Text
    if name == "" then return log("set a block name", "err") end
    local id = tonumber(idBox.Text) or 9
    local rf, e = resolveRF()
    if not rf then return log(e, "err") end
    local z = findZone()
    if not z then return log("plot zone not found", "err") end
    local origin = originPoint()
    if not origin then return log("no position (no character)", "err") end

    local nx, ny = grid[1], grid[2]
    local done, fail = 0, 0
    log(("placing %dx%d %s"):format(nx, ny, name))
    for x = -(nx - 1) / 2, (nx - 1) / 2 do
        for y = 0, ny - 1 do
            local p = origin + Vector3.new(x * spacing, y * spacing, 0)
            local ok = pcall(rf.InvokeServer, rf, name, id, z,
                z.CFrame:ToObjectSpace(CFrame.new(p)), true, p, false)
            if ok then done += 1 else fail += 1 end
            task.wait(0.03)
        end
    end
    log(("%s: %d ok, %d failed"):format(name, done, fail), fail > 0 and "warn" or "ok")
end

local function probe()
    local name = nameBox.Text
    if name == "" then return log("set a block name", "err") end
    local rf, e = resolveRF()
    if not rf then return log(e, "err") end
    local z = findZone()
    if not z then return log("plot zone not found", "err") end

    local before = count(z)
    local p = z.Position + Vector3.new(0, 40, 0)
    local ok = pcall(rf.InvokeServer, rf, name, 9, z,
        z.CFrame:ToObjectSpace(CFrame.new(p)), true, p, false)
    task.wait(0.4)
    local spawned = ok and count(z) > before
    log(name .. (spawned and " -> SPAWNED" or " -> nothing"), spawned and "ok" or "err")
    addResult(name, spawned)
end

local function dump()
    local n = 0
    for _, v in ipairs(LocalPlayer:GetChildren()) do
        if v.Name == "Data" then
            for _, b in ipairs(v:GetChildren()) do addResult(b.Name, nil); n += 1 end
        end
    end
    for _, v in ipairs(RS:GetDescendants()) do
        if v:IsA("Folder") and #v:GetChildren() > 3 then addResult(v.Name, nil); n += 1 end
    end
    log(("dumped %d names"):format(n), n > 0 and "ok" or "warn")
end

button("PLACE", 152, 10, 281, Color3.fromRGB(52, 110, 72), place)
button("PROBE", 76, 168, 281, C.panel, probe)
button("DUMP", 76, 250, 281, C.panel, dump)

