local grid, spacing, atCursor = { 3, 3 }, 4, false

local function equip()
    local char, bp = LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")
    local t = (char and char:FindFirstChild("BuildingTool")) or (bp and bp:FindFirstChild("BuildingTool"))
    if t and bp and t.Parent == bp and char and char:FindFirstChild("Humanoid") then
        pcall(function() char.Humanoid:EquipTool(t) end)
        task.wait(0.2)
    end
    return t
end

local function findZone()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myTeam = LocalPlayer.TeamColor
    local function scan(container, depth)
        for _, v in ipairs(container:GetChildren()) do
            if v:IsA("BasePart") then
                local tc = v:FindFirstChild("TeamColor")
                if tc then
                    local val = tc:IsA("ValueBase") and tc.Value or tc
                    if val == myTeam then return v end
                end
            end
            if depth < 4 and (v:IsA("Folder") or v:IsA("Model")) and v ~= LocalPlayer.Character then
                local r = scan(v, depth + 1)
                if r then return r end
            end
        end
    end
    local found = scan(workspace, 0)
    if found then return found end
    if root then
        local best, bestD = nil, math.huge
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Anchored and v.Size.X > 24 and v.Size.Z > 24 then
                local d = (v.Position - root.Position).Magnitude
                if d < bestD then best, bestD = v, d end
            end
        end
        if best and bestD < 300 then return best end
    end
end

local function count(z)
    local n = 0
    for _ in z:GetDescendants() do n += 1 end
    return n
end

